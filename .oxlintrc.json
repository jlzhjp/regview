{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": ["vite.config.ts", "scripts/**/*.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["internal/assets/dist/**"]
}
