package admin

import (
	"net/url"
	"regview/internal/catalog"
	"strconv"
)

templ page(view catalog.View) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"allowEval":false}'/>
			<title>regview</title>
			<link rel="stylesheet" href="/assets/frontend/app.css"/>
			<script type="module" src="/assets/frontend/app.js"></script>
		</head>
		<body>
			<a href="#main" class="skip-link sr-only focus:not-sr-only">Skip to content</a>
			<main id="main" tabindex="-1" class="shell">
				<header class="masthead">
					<h1 class="flex items-center gap-2"><span class="icon icon-box" aria-hidden="true"></span>regview</h1>
					<div class="theme-control">
						<label for="theme">Theme</label>
						<select id="theme" name="theme">
							<option value="system">System</option>
							<option value="light">Light</option>
							<option value="dark">Dark</option>
						</select>
					</div>
				</header>
				<p class="intro">Local images exposed by the registry. Docker wins conflicting tags.</p>
				<form action="/images" method="get" hx-get="/images" hx-target="#inventory" class="toolbar" role="search">
					<label for="query">Filter images</label>
					<input id="query" name="q" type="search" placeholder="repository, tag, or backend"/>
					<button type="submit" class="action"><span class="icon icon-search" aria-hidden="true"></span>Search / refresh</button>
				</form>
				<p id="request-status" role="alert" class="request-status"></p>
				<div id="inventory" aria-live="polite">@inventory(view)</div>
				<section id="details" aria-live="polite" aria-label="Manifest details"></section>
			</main>
		</body>
	</html>
}

templ inventory(view catalog.View) {
	<p class="inventory-time">Live inventory queried: { view.Updated.Format("2006-01-02 15:04:05 MST") }</p>
	<h2>Backends</h2>
	<ul class="backend-list">
		for _, status := range view.Status {
			<li>
				{ status.Backend }: { strconv.Itoa(status.Images) } exposed references
				if status.Error != "" {
					<strong class="backend-error">Unavailable: { status.Error }</strong>
				}
			</li>
		}
	</ul>
	<h2>Images</h2>
	<div class="table-scroll" role="region" aria-label="Image inventory" tabindex="0">
		<table class="inventory-table">
			<caption class="sr-only">Local image references and backend selection</caption>
			<thead><tr><th scope="col">Registry</th><th scope="col">Repository</th><th scope="col">Tag</th><th scope="col">Backend</th><th scope="col">Selection</th><th scope="col">Stored digest</th><th scope="col">Manifest</th></tr></thead>
			<tbody>
				for _, row := range view.Rows {
					<tr>
						<td>{ row.Host }</td>
						<td>{ row.Repository }</td>
						<td>{ row.Tag }</td>
						<td>{ row.Backend }</td>
						<td>
							if row.Selected {
								<span class="state state-selected">selected</span>
							}
							if row.Conflict {
								<strong class="state state-conflict">conflict</strong>
							}
						</td>
						<td><code>{ row.OriginalDigest }</code></td>
						<td>
							if row.Selected {
								<a href={ templ.SafeURL(manifestURL(row)) } hx-get={ manifestURL(row) } hx-target="#details" class="action"><span class="icon icon-code" aria-hidden="true"></span>View manifest<span class="sr-only">{ " for " }{ row.Host }/{ row.Repository }:{ row.Tag }</span></a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if len(view.Rows) == 0 {
		<p>No images match the configured hosts and filter.</p>
	}
}

func manifestURL(row catalog.Row) string {
	return "/manifest?" + url.Values{"host": {row.Host}, "repository": {row.Repository}, "reference": {row.Tag}}.Encode()
}

templ manifestDetails(digest, data string) {
	<h2>Manifest</h2>
	<p>Served digest: <code>{ digest }</code></p>
	<pre>{ data }</pre>
}
